{
  "name": "teamsmith",
  "version": "0.1.1",
  "description": "Turn one agent session into a project owner: self-contained task briefs dispatched to worker agents in their own git worktrees, independent verification on a separate checkout, and an auditable ledger (BOARD / reviews / threads / DECISIONS). Runs on Pi today.",
  "license": "MIT",
  "bin": {
    "team": "./bin/team.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Track07-cda/teamsmith.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "teamsmith",
    "agents",
    "multi-agent",
    "orchestration",
    "tmux",
    "git-worktree",
    "project-management"
  ],
  "files": [
    "skills/",
    "bin/",
    "install.sh"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "TEAM_SMOKE_FAST=1 bash skills/teamsmith/tests/smoke.sh",
    "test:full": "bash skills/teamsmith/tests/smoke.sh",
    "gates": "openspec validate --all --strict && bash skills/teamsmith/tests/smoke.sh"
  }
}
