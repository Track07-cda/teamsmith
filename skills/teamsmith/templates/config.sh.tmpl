# teamsmith project config (generated by `team init`; edit freely; sourced by bash and parsed by the notify extension)
#
# Format: flat `TEAM_KEY="value"`, one per line, no newlines inside values.
# The notify extension reads only a few keys and does **not** source this file (it never runs project code).

# ---- identity ----
TEAM_PROJECT="{{PROJECT}}"
TEAM_SESSION="{{SESSION}}"            # tmux session name (the PM and every agent live in this one session)
# The PM window name is a convention, not a copy of whatever the window happens to be called right now:
# `team bootstrap` writes this default and renames a differently-named current window instead of inheriting it.
TEAM_PM_WINDOW="{{PM_WINDOW}}"        # window running the PM; notifications are typed into it

# ---- roster and models ----
TEAM_AGENTS="{{AGENTS}}"
# Per-agent default model (optional; falls back to TEAM_DEFAULT_MODEL): "dev=deepseek/deepseek-flash verify=xai/grok-4.6"
TEAM_AGENT_MODELS=""
TEAM_DEFAULT_MODEL="{{DEFAULT_MODEL}}"
# Concurrency caps ("provider/model=N"): important when a provider quota is small,
# e.g. "kimi-coding/k3=2 openai-codex/gpt-5.6-sol=1" (wildcards allowed)
TEAM_MODEL_LIMITS="kimi-coding/k3=2 openai-codex/*=1"
# Extra arguments appended to the agent CLI on dispatch (space separated)
TEAM_EXTRA_PI_ARGS=""

# ---- agent adapter (workers may be any TUI agent; leave all four empty for the built-in Pi behaviour) ----
# launch template; placeholders: {cwd} {session_id} {model} {provider} {prompt_file} {prompt}
#                             {skill_dir} {notify_ext} {extra_args}
# (any unknown/malformed placeholder, a blank template or a newline aborts the dispatch; the first word must be
#  a bare executable name)
TEAM_AGENT_CMD=""
# end-of-turn notification; placeholders: {summary_file} {summary} {agent} {cwd} {session_id} {model} {provider} {skill_dir}
# The summary is data: the worker writes it into {summary_file} and runs a fixed command, so nothing it types is ever
# interpolated into a shell line. {summary} is kept for old templates (rendered as a quoted read of that file).
TEAM_AGENT_NOTIFY_CMD=""
# log source for `team monitor --activity` ({agent} = agent name), e.g. '~/.local/share/opencode/log/*.log'
TEAM_AGENT_LOG_GLOB=""
# adapter binary (window readiness wait / existence checks); empty = first word of TEAM_AGENT_CMD
TEAM_AGENT_BIN=""
# example (opencode):
#   TEAM_AGENT_CMD='opencode run --model {provider}/{model} --dir {cwd} "$(cat {prompt_file})"'
#   TEAM_AGENT_BIN="$HOME/.opencode/bin/opencode"
#   TEAM_AGENT_NOTIFY_CMD='bash {skill_dir}/scripts/team notify pm --from-file {summary_file}'
#   TEAM_AGENT_MODELS="dev=google/gemini-3-flash-preview"

# ---- workflow ----
TEAM_GATES="{{GATES}}"                # gate command; verification runs it on an independent checkout
TEAM_PI_BIN="pi"                      # agent CLI binary (use an absolute path if it is not on PATH)
TEAM_INSTALL_CMD=""                   # dependency install after creating a worktree, e.g. "pnpm install --frozen-lockfile"
TEAM_DOCS_DIR="{{DOCS_DIR}}"          # where briefs/reports/threads/inbox live
TEAM_WORKTREES_DIR=".worktrees"
# Branch model: task (default; one branch per task -- the unit of verification/merge/rollback) | agent (one long-lived branch per agent)
TEAM_BRANCH_MODE="task"
TEAM_TASK_BRANCH_PREFIX="task"
TEAM_TASK_BRANCH_RESET=1              # after close, switch the agent worktree back to the protected branch
TEAM_PROTECTED_BRANCH="main"          # agents must never push it; they open PR/MRs or hand over to the PM
TEAM_REMOTE="origin"

# ---- version control / forge ----
# {{DETECTED_VCS}} was auto-detected for this repo; local = no forge, the PM squash-merges locally.
TEAM_VCS="{{VCS}}"                    # local | github | gitlab | other (a label only; the skill calls no forge)
TEAM_TOKEN_FILE=".gh-pat"             # optional: PAT file at the repo root (chmod 600, gitignored) for the PM's own calls
TEAM_GITLAB_HOST=""                   # optional: e.g. https://gitlab.example.com:8443
TEAM_GITLAB_PROJECT=""                # optional: e.g. group/sub/project
TEAM_GITLAB_TOKEN_FILE="$HOME/.gitlab-pa-token"
TEAM_CONFIRM_WRITES=1                 # 1 = every shared-state change needs --yes (recommended)

# ---- guards (the floor is: swap must not be exhausted; tight RAM only means slowness) ----
TEAM_MIN_FREE_SWAP_MB=1024            # refuse dispatch below this much free swap (exhaustion gets processes OOM-killed)
TEAM_MIN_TOTAL_MB=512                 # absolute floor for RAM + swap
TEAM_REVIEW_TIMEOUT=1800              # hard timeout for verification gates (seconds); a timeout counts as FAIL
TEAM_MIN_AVAIL_MB=1024                # hard floor for MemAvailable (one machine used 4096 here)
TEAM_WARN_AVAIL_MB=4096               # below this MemAvailable: warn only (slowness is acceptable)
TEAM_ZRAM_WARN_PCT=85                 # warn above this zram usage (zram pages live in RAM)
TEAM_AGENT_MEM_MB=6144                # empirical memory per agent, used by `team ps` estimates
TEAM_NOTIFY_TMUX=1                    # 0 = write the inbox only, never knock on the PM window
TEAM_NOTIFY_DEDUP_SEC=20              # dedup window for identical briefings (Pi may settle repeatedly)
TEAM_INBOX_MAX_CHARS=150
TEAM_NOTIFY_LOG="/tmp/{{PROJECT}}-teamsmith-notify.log"
# ---- deferred delivery (delivery-guard: never type into an input box that already holds a draft) ----
TEAM_DEFER_TTL=300                    # seconds a queued message may wait before it moves to state/outbox/held/
TEAM_OUTBOX_MAX=200                   # maximum active queue entries (the oldest escalates to held/ beyond it)

# ---- periodic patrol (the metronome that wakes the PM) ----
# Renamed watchdog → pulse in v1.36.0: the legacy TEAM_WATCH_* names keep working as fallbacks until v2.0.0
# (precedence: TEAM_PULSE_<NAME> > TEAM_WATCH_<NAME> > default; `team pulse status` names any legacy variable in effect).
TEAM_PULSE_WINDOW="pulse"           # tmux window running the monitor
TEAM_MONITOR_REFRESH=3                # monitor refresh interval (seconds); console default (was 5)
TEAM_PULSE_PENDING_BOARD=0            # 0 = board todo/wip is not a wake-up signal (blocked/unread/awaiting review/stopped agents are)
TEAM_MONITOR_ACTIVITY=0               # 1 = append per-agent activity streams below the panel (current session only)
TEAM_MONITOR_EVENTS=4                 # recent events per agent when activity is enabled
# Required dependencies: magic-context (the PM's cross-compaction, cross-restart memory) and OpenSpec
# (the spec layer: why a change happens / what it changes). `team doctor` fails when one is missing;
# dispatch only warns (a worker can still work), bootstrap prints the fix. Set a TEAM_REQUIRE_*=0 to downgrade.
TEAM_REQUIRE_MAGIC_CONTEXT=1
TEAM_PI_SETTINGS_FILE="$HOME/.pi/agent/settings.json"   # where the extension is detected (tests/multi-user: point it elsewhere)
TEAM_REQUIRE_OPENSPEC=1
TEAM_OPENSPEC_BIN="openspec"                           # absolute path allowed, same pattern as TEAM_PI_BIN
TEAM_SPEC_DIR="openspec"                              # the project's OpenSpec root (relative to the main worktree)
TEAM_PULSE_INTERVAL=900               # patrol interval (seconds): 15 minutes by default, 300-3600 recommended
TEAM_PULSE_NUDGE_GAP=900              # minimum gap before the same backlog is mentioned again (seconds)
TEAM_PULSE_REBUILD_TMUX=0             # 0 = leave tmux alone (report a missing session/window); 1 = allow rebuilding
TEAM_PULSE_MAX_RESTARTS=5             # maximum automatic PM restarts per hour (crash-loop guard)
TEAM_PM_MODEL=""                      # the PM's own model; empty = TEAM_DEFAULT_MODEL
TEAM_PM_SESSION_ID=""                 # empty = `pi -c` (continue the previous session in this directory, keeping history)
TEAM_PM_EXTRA_PI_ARGS=""

# ---- misc ----
# Recorded by init for humans: skill path {{SKILL_DIR}}; initialised on {{TODAY}}
