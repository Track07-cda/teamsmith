#!/usr/bin/env bash
# teamsmith · tmux 运行时闸门（M36 建；M67 起判定改为「按目标 + argv token」）—— 被注入到 agent
# 会话（PM 与 worker 窗口）PATH 最前的 `tmux` 包装。
#
# 为什么存在：默认 tmux server 多次全灭（PM/pulse/worker + 共用同一 server 的其他项目一起陪葬），
# 而默认 server 死亡不留任何日志，肇事命令查不出来。M28 的 lint（tests/tmux-lint.pl）只能静态管
# 仓库脚本，管不到 agent 在窗口里的 ad-hoc 命令 —— 这道闸门管的就是它们：
#
#   记录  每次调用追加一行到 $TEAM_TMUX_CALLS_LOG（时间/socket/TMUX/TMUX_TMPDIR/参数/pid/ppid/cwd/动作），
#         上限 2000 条调用行（超了留最新 1000 条；首行一条累计 `dropped=<N>` 轮转标记自述被裁掉多少
#         —— 读不到某次调用时能分清「没发生」与「被轮转掉」）——默认 server 再死也能倒查「谁在什么时候打了什么」。
#   判定  **按目标**（M67）：解析到默认 socket（/tmp/tmux-<uid>/default）的破坏性调用
#         （kill-server/kill-session/kill-window/kill-pane，含 tmux 允许的前缀写法）只在目标能证明是
#         调用者自己会话里的命名对象时执行；**环境变量不授权任何东西**（M62 的泄漏链：team 的 export +
#         tmux 把 server 环境复制进每个新 pane，等于给共享 server 上所有项目的窗口发授权）。
#   动作  审计词汇只有四个：pass（不拦）/ allowed-owned（放行·自己的命名对象）/
#         refused（拒绝，exit 64）/ explicit-flag（调用者在 argv 里的显式授权）。
#
# M67 判定表（解析到共享默认 socket 的破坏性调用）：
#   kill-server                 → 拒绝（对象是整台 server，不是任何项目的命名对象）
#   kill-session -a             → 拒绝（-a 加宽到本 server 上除目标外的所有会话，没有目标能约束影响面）
#   kill-session/-window/-pane  → 仅当有效 -t 非空、它的 session 段（第一个 `:` 之前）字面等于非空的
#                                 TEAM_SESSION，且这个身份**绑定**到调用者
#                                 （TEAM_ROOT / TEAM_MAIN_ROOT 是 cwd 或 cwd 的祖先）→ allowed-owned
#   其余形状（无 -t / -t "" / %N / @N / :win / 相对目标 / 别的会话 / 身份缺失或未绑定）→ 拒绝；
#   不可证明的一律拒绝（认得 -t x 与 -tx，组合旗标簇按 tmux 的 args_parse 逐字符走，最后一个 -t 胜出）。
#   私有 socket 一律 pass（M41 的 socket 表与假隔离判定原样保留）。**假隔离**（声明了 TMUX_TMPDIR 但
#   它不可用、真 tmux 会静默回退默认 socket）即使 -t 看着是自己的也拒绝：那时候命中的同名会话可能
#   是共享 server 上别人的。
#   `--teamsmith-allow-destructive`（**只在子命令之前的全局参数位**识别）是唯一的带内放行：剥掉它再
#   执行、记 act=explicit-flag，任何 socket 上都执行（这是调用者的显式授权）；子命令之后的同名词是
#   数据，原样透传；`=1` 形式不识别（透传给真 tmux 报错 = fail closed）。
#   TEAM_ALLOW_DESTRUCTIVE_TMUX 已退役（M67）：本闸门不读它，它在调用方环境里、甚至在这台 server 的
#   全局环境里都不改变任何判定；团队 CLI 不再导出它。
#
# socket 解析与 tmux（3.7b）一致：-S/-L（命令行显式） > $TMUX（第一个逗号前，且不以逗号开头） >
# <tmpdir>/tmux-<uid>/default。tmpdir 不是「${TMUX_TMPDIR:-/tmp}」这么一条公式，而是一张**路径表**
# `TMUX_SOCK = "$TMUX_TMPDIR:/tmp/"`（strings 实证）：逐项 env 展开 + realpath(3)，**realpath 失败的项
# 直接跳过**，取第一个可用的 —— 所以 TMUX_TMPDIR 指向不存在的目录（父目录缺失/死软链/空值）时，真 tmux
# 会静默回退 /tmp 的默认 socket（M41：2026-09-19 第 6 次默认 server 死亡就是这条「假隔离」）。
# 判定用的是**规范化**后的路径（realpath 掉 . / .. / 软链），因为内核就是这么解析的：
# `-S /tmp/tmux-1000/../tmux-1000/default` 连的是默认 server，`/tmp/../tmp` 当 TMPDIR 也是默认目录。
# 「默认」只按最终解析出的路径判定：-L default 打在默认 TMPDIR 上照样算默认；TMUX_TMPDIR 指向私有目录就算私有。
#
# M41 补上的第二形态（同一张表，另一种读法）：tmpdir 候选必须**存在且是目录**（tmux 要在它下面 mkdir
# `tmux-<uid>`；realpath 失败或不是目录都到不了私有 socket）。两类后果都要按「假隔离」处理，因为报出来的
# 命令看着是隔离过的、实际没有：
#   · 不存在/空值/死软链 → 真 tmux **静默回退** /tmp 的默认 socket —— kill-* 必须拒；
#   · 存在但不是目录（普通文件）→ 真 tmux 直接报错（不会回退，也到不了默认）——本闸门保守地按「不可用 →
#     默认」判（重拒不漏拒；判定详情见 M41 报告的实测矩阵）。
#
# ⚠ 已知盲区（M41）：本闸门是 **PATH 里的可执行文件**，只有经 PATH 解析到的 `tmux` 才被拦住。
#   · `/usr/bin/tmux` 这类**绝对路径**直接 exec，绕过本闸门（2026-09-19 第 8 次默认 server 死亡的凶手就是
#     它：PM 用绝对路径 + TMUX_TMPDIR=<未创建目录> 跑 kill-server）；仓库脚本/fixture 里禁止用绝对路径做
#     破坏性调用（tests/tmux-lint.pl 的 M41 规则会报红）；
#   · `command tmux` / `env tmux` **不**绕行（`command` 只跳过函数/别名，PATH 解析照旧，照样命中本闸门）；
#   · `TEAM_TMUX_REAL=<绝对路径>` 是本闸门自己解析真身用的出口，不受影响。
#
# 三条硬原则（M36 返工实录，违反任意一条都是事故级）：
#   透传保真  判定在**副本**上解析、执行用**调用者原始的** argv —— 把 -L/-S 从 argv 里吃掉会让
#             「判定打私有、执行打默认」分家（被执行的 kill 会落默认 server）。唯一的例外是闸门自己的
#             token（它不是 tmux 的参数，必须剥掉才递得下去）。
#   绝不挂住  无子命令 / 缺值参数（tmux -L）/ -V 等全部透传给真 tmux（它自己报错退出）；
#             解析循环每条路径要么 shift ≥1 要么 break。
#   环境零授权 判定只看「目标 + 绑定到调用者的身份 + argv token」，不看任何环境变量的值。
set -u

# ── 找真 tmux：PATH 里第一个「不是我自己」的 tmux（防递归；TEAM_TMUX_REAL 显式指定优先）────────
_shim_self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
_real=""
if [ -n "${TEAM_TMUX_REAL:-}" ] && [ -x "${TEAM_TMUX_REAL:-}" ]; then
  _c="$(readlink -f "$TEAM_TMUX_REAL" 2>/dev/null || printf '%s' "$TEAM_TMUX_REAL")"
  [ "$_c" != "$_shim_self" ] && _real="$TEAM_TMUX_REAL"
fi
if [ -z "$_real" ]; then
  _oldifs="$IFS"; IFS=':'
  for _d in $PATH; do
    IFS="$_oldifs"
    [ -n "$_d" ] || continue
    _cand="$_d/tmux"
    [ -x "$_cand" ] || continue
    _cc="$(readlink -f "$_cand" 2>/dev/null || printf '%s' "$_cand")"
    [ "$_cc" = "$_shim_self" ] && continue      # 跳过自己（PATH 里前面的 shim 位置）
    _real="$_cand"; break
  done
  IFS="$_oldifs"
fi
if [ -z "$_real" ]; then
  printf '✗ teamsmith tmux 闸门：PATH 里找不到真 tmux（只找到我自己）——把真 tmux 的目录加进 PATH，或设 TEAM_TMUX_REAL=<绝对路径>\n' >&2
  exit 127
fi

# 原始 argv 的快照（日志与「调用者原始 argv」的逐字节透传都看它；后面 shift 只动函数参数）
_shim_argv=("$@")
_shim_argc=$#
_shim_cwd="$(pwd -P 2>/dev/null || printf '%s' "${PWD:-}")"

# ── 解析全局参数（**只吃副本**：函数位置参数是调用者 "$@" 的拷贝，caller 的 "$@" 不动）────────
# 缺值参数（$#<2）直接 break：不完整调用透传给真 tmux 自己报错；每条路径要么 shift ≥1 要么 break，绝不挂住。
# 产出：_sockname/_sockpath（-L/-S）、_sub（子命令）、_glob_end（全局区结束下标 = 子命令所在下标，
# 没有子命令时 = 词数）、_tokenn（全局区里的 token 次数）、_tail（子命令之后的参数）。
_parse_globals() {
  _sockname="" _sockpath="" _sub="" _tokenn=0 _glob_end=0 _tail=()
  local _n=$# _i=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -L)
        [ $# -ge 2 ] || { _i=$((_i + 1)); shift; break; }
        _sockname="$2"; _i=$((_i + 2)); shift 2 ;;
      -L*) _sockname="${1#-L}"; _i=$((_i + 1)); shift ;;
      -S)
        [ $# -ge 2 ] || { _i=$((_i + 1)); shift; break; }
        _sockpath="$2"; _i=$((_i + 2)); shift 2 ;;
      -S*) _sockpath="${1#-S}"; _i=$((_i + 1)); shift ;;
      -c|-f|-T)
        [ $# -ge 2 ] || { _i=$((_i + 1)); shift; break; }
        _i=$((_i + 2)); shift 2 ;;
      --)
        # `--` 之后的第一个词是子命令位：token 只认它**之前**的全局参数位
        _glob_end=$((_i + 1)); _i=$((_i + 1)); shift
        [ $# -gt 0 ] && { _sub="$1"; _i=$((_i + 1)); shift; }
        _tail=("$@"); return 0 ;;
      --teamsmith-allow-destructive) _tokenn=$((_tokenn + 1)); _i=$((_i + 1)); shift ;;
      -*) _i=$((_i + 1)); shift ;;            # 其它全局开关（-2 -C -l -u -v -V …）
      *)  _glob_end="$_i"; _sub="$1"; _i=$((_i + 1)); shift; _tail=("$@"); return 0 ;;
    esac
  done
  _glob_end="$_i"
  _tail=()
}
# 空数组在 set -u 下的展开（bash < 4.4 会报 unbound）：有元素才展开
_parse_globals ${_shim_argv[@]+"${_shim_argv[@]}"}

# ── 破坏性集合 → 具体子命令：四个 kill-*；tmux 允许前缀写法（kill-s 之类），多个候选 = 前缀有歧义 ──
_destructive=0 _kind=""
case "$_sub" in
  kill-*)
    _hits=""
    for _cand in kill-server kill-session kill-window kill-pane; do
      case "$_cand" in "$_sub"*) _hits="${_hits:+$_hits }$_cand" ;; esac
    done
    case "$_hits" in
      '') ;;
      *' '*) _destructive=1; _kind="ambiguous" ;;
      *)     _destructive=1; _kind="$_hits" ;;
    esac ;;
esac

# ── 子命令之后的参数 → 有效 -t 与加宽旗标 -a（tmux 的 args_parse 语义：最后一个 -t 胜出；
#    `-t x` 与 `-tx` 都认；组合旗标簇逐字符走，`t` 吃掉本词剩余部分或下一个词）──────────────
# 认不出的旗标 / 位置参数 = 不可证明（默认 socket 上拒；tmux 本来也会报 usage 错）。
_t_set=0 _t_val="" _widening=0 _unprovable=0
_parse_target() {
  _t_set=0 _t_val="" _widening=0 _unprovable=0
  local _n=$# _i=0 _ch _tailch _skip
  local -a _a=("$@")
  while [ "$_i" -lt "$_n" ]; do
    case "${_a[$_i]}" in
      -t)
        if [ $((_i + 1)) -lt "$_n" ]; then _t_val="${_a[$((_i + 1))]}"; _i=$((_i + 2))
        else _t_val=""; _i=$((_i + 1)); fi
        _t_set=1 ;;
      -t*) _t_val="${_a[$_i]#-t}"; _t_set=1; _i=$((_i + 1)) ;;
      -)   _unprovable=1; _i=$((_i + 1)) ;;
      -*)
        _tailch="${_a[$_i]#-}"; _skip=0
        while [ -n "$_tailch" ]; do
          _ch="${_tailch%"${_tailch#?}"}"; _tailch="${_tailch#?}"
          case "$_ch" in
            a) _widening=1 ;;                         # kill-session -a（加宽）
            C) : ;;                                   # kill-session -C（清告警）：仍按目标判定
            t)
              if [ -n "$_tailch" ]; then _t_val="$_tailch"
              elif [ $((_i + 1)) -lt "$_n" ]; then _t_val="${_a[$((_i + 1))]}"; _skip=1
              else _t_val=""; fi
              _t_set=1; _tailch="" ;;
            *) _unprovable=1 ;;
          esac
        done
        _i=$((_i + 1 + _skip)) ;;
      *) _unprovable=1; _i=$((_i + 1)) ;;              # 这些子命令不收位置参数（tmux 会报 usage）
    esac
  done
}
if [ "${#_tail[@]}" -gt 0 ]; then _parse_target "${_tail[@]}"; fi

# ── 解析 socket（与 tmux 同源，含**回退**；M41）────────────────────────────────────────────────
_uid="${UID:-$(id -u 2>/dev/null || echo 0)}"

# realpath(3) 语义的规范化：整条路径必须存在（不存在/死软链 → 空 + 非 0）。
# 注意 realpath(1) 的默认行为会放行「只缺最后一段」的路径（实测 rc=0），所以必须带 -e；
# 没有 realpath(1)（或不认 -e）时退回「[ -e ] + readlink -f」——同样要求整条路径存在。
_real_existing() {
  local _p="${1:-}" _r
  [ -n "$_p" ] || return 1
  if _r="$(realpath -e -- "$_p" 2>/dev/null)" && [ -n "$_r" ]; then printf '%s' "$_r"; return 0; fi
  if [ -e "$_p" ] && _r="$(readlink -f -- "$_p" 2>/dev/null)" && [ -n "$_r" ]; then printf '%s' "$_r"; return 0; fi
  return 1
}

# 目录版：存在且是目录（TMUX_TMPDIR 候选的判据 —— tmux 要在它下面 mkdir `tmux-<uid>`；普通文件会让
# 真 tmux 直接报错）。不判可写/可执行位：真 tmux 的判据是「mkdir 成功或 EEXIST」，shim 不能为了判定去 mkdir
# （有副作用）；而不可写的 tmpdir 也到不了默认 socket（mkdir 失败即退出），漏判这一维不会漏放行默认 server。
_real_dir() {
  local _r
  _r="$(_real_existing "${1:-}")" || return 1
  [ -d "$_r" ] || return 1
  printf '%s' "$_r"
}

# 路径形态 socket 的规范化：
#   · 整条路径已存在（含 socket 文件本身、指向 socket 的软链）→ 全量 realpath —— 内核就是这么解析的，
#     `-S <软链→默认 socket>` 连的就是默认 server，不能按字面放过；
#   · 只缺最后一段 → 把能解析的父目录 realpath 掉再拼回基名；
#   · 父目录也解析不了 → 原样返回（内核同样解析不了 → 打不到默认 socket，按「非默认」判是安全的）。
_sock_canon() {
  local _p="${1:-}" _d _b _c _f
  if _f="$(_real_existing "$_p")"; then printf '%s' "$_f"; return 0; fi
  case "$_p" in
    */*)
      _d="${_p%/*}"; _b="${_p##*/}"; [ -n "$_d" ] || _d="/"
      if [ -n "$_b" ] && _c="$(_real_existing "$_d")"; then printf '%s/%s' "$_c" "$_b"; return 0; fi ;;
  esac
  printf '%s' "$_p"
}

# tmpdir = 路径表 `$TMUX_TMPDIR:/tmp/` 里第一个 realpath 成功**且是目录**的项（与 tmux 逐项筛选同源）。
# 被跳过的 TMUX_TMPDIR 要留痕：拒绝时点明这是「假隔离」（真 tmux 会回退默认 socket / 直接报错）。
# 注意「默认 socket」是**固定靶**（/tmp/tmux-<uid>/default，那台所有项目共用的 server），不是「本调用算出来的
# 那个 default」—— TMUX_TMPDIR 指向私有目录时，它的 `<私有>/tmux-<uid>/default` 是一台**私有** server，kill 掉
# 它不算事故（M36 三态的「私有放行」就是这个语义）。
_default_tmpdir="$(_real_dir /tmp)" || _default_tmpdir=/tmp
_default_sock="$_default_tmpdir/tmux-$_uid/default"
_tmpdir="" _tmpdir_fell_back=0
if [ -n "${TMUX_TMPDIR:-}" ]; then
  _tmpdir="$(_real_dir "${TMUX_TMPDIR:-}")" || _tmpdir_fell_back=1
fi
[ -n "$_tmpdir" ] || _tmpdir="$_default_tmpdir"

if [ -n "$_sockpath" ]; then _sock="$(_sock_canon "$_sockpath")"
elif [ -n "$_sockname" ]; then _sock="$(_sock_canon "$_tmpdir/tmux-$_uid/$_sockname")"
elif [ -n "${TMUX:-}" ] && [ "${TMUX:0:1}" != "," ]; then _sock="$(_sock_canon "${TMUX%%,*}")"
else _sock="$_tmpdir/tmux-$_uid/default"
fi
_sock="${_sock%/}"   # 尾斜杠归一

# ── 身份绑定（M40 契约的闸门读法）：TEAM_SESSION 只有在 TEAM_ROOT / TEAM_MAIN_ROOT
#    解析后是 cwd 或它的祖先时才算「调用者自己的」——继承来的会话名不算授权。──────────────
_identity_bound() {
  local _r _rr
  for _r in "${TEAM_ROOT:-}" "${TEAM_MAIN_ROOT:-}"; do
    [ -n "$_r" ] || continue
    _rr="$(readlink -f -- "$_r" 2>/dev/null || true)"
    [ -n "$_rr" ] || _rr="$_r"
    case "$_shim_cwd/" in "$_rr"/*) return 0 ;; esac
  done
  return 1
}

# ── 裁决：token > 只读/私有 socket > 默认 socket 上的目标归属 ─────────────────────────────────
_act="pass" _cls="" _sess=""
if [ "$_tokenn" -gt 0 ]; then
  _act="explicit-flag"
elif [ "$_destructive" = "1" ] && [ "$_sock" = "$_default_sock" ]; then
  if [ "$_tmpdir_fell_back" = "1" ]; then
    _cls="fake-isolation"
  else
    case "$_kind" in
      kill-server) _cls="server" ;;
      ambiguous)   _cls="ambiguous" ;;
      *)
        if [ "$_kind" = "kill-session" ] && [ "$_widening" = "1" ]; then _cls="widening"
        elif [ "$_t_set" != "1" ] || [ -z "$_t_val" ]; then _cls="no-target"
        elif [ "$_unprovable" = "1" ]; then _cls="unprovable"
        else
          _sess="${_t_val%%:*}"
          case "$_sess" in
            ''|'%'*|'@'*|'.'|'+'|'-') _cls="not-literal" ;;
            *)
              if [ -z "${TEAM_SESSION:-}" ]; then _cls="no-identity"
              elif [ "$_sess" != "$TEAM_SESSION" ]; then _cls="not-own"
              elif ! _identity_bound; then _cls="unbound"
              fi ;;
          esac
        fi ;;
    esac
  fi
  [ -n "$_cls" ] && _act="refused" || _act="allowed-owned"
fi

# ── 记录（尽力而为：写不进去不挡路；FIFO 目标会阻塞写端，直接跳过 —— 日志绝不能挂住调用）────────
if [ -n "${TEAM_TMUX_CALLS_LOG:-}" ] && [ ! -p "${TEAM_TMUX_CALLS_LOG}" ]; then
  _log="${TEAM_TMUX_CALLS_LOG}"
  _ld="$(dirname "$_log")"
  [ -d "$_ld" ] || mkdir -p "$_ld" 2>/dev/null || true
  _argv="$(printf '%s' "$*" | tr '\r\n' '  ')"
  printf '%s · act=%s · sock=%s · TMUX=%s · TMUX_TMPDIR=%s · argv=%s · pid=%s ppid=%s cwd=%s\n' \
    "$(date -Is)" "$_act" "$_sock" "${TMUX:--}" "${TMUX_TMPDIR:--}" "$_argv" "$$" "${PPID:-?}" "$PWD" \
    >> "$_log" 2>/dev/null || true
  # 截断：超 2000 条**调用行**留最新 1000 条（同目录临时文件 + mv；失败就算了，日志不是命门）。
  # P77：被裁掉的历史必须**自述**——轮转后首行是 `<ISO 时间> · rotation · dropped=<N>`，
  # N = 累计被裁掉的调用行数（前一个 marker 的 N + 本次裁掉的）；marker 不是调用行（不带 act=，
  # 四值动作词汇表保持封闭），没越界就一条 marker 都不写。
  _n="$(wc -l < "$_log" 2>/dev/null | tr -dc '0-9')"
  if [ -n "$_n" ] && [ "$_n" -gt 2000 ]; then
    _prev=0
    _first="$(head -n 1 "$_log" 2>/dev/null || true)"
    # marker 形状是**严格**的：时间戳之后紧接 ` · rotation · dropped=<N>`。不能用带 * 的 glob
    # 一把抓（`T*' · rotation · dropped='*` 会把 argv 里带这句话的**调用行**也吃掉），
    # 所以先按第一个 ` · ` 切出时间戳，再要求剩余部分**以** ` · rotation · dropped=` 开头。
    _t="${_first%% · *}"
    _rest="${_first#"$_t"}"
    case "$_rest" in
      ' · rotation · dropped='*)
        _d="${_rest#' · rotation · dropped='}"
        case "$_d" in
          ''|*[!0-9]*) : ;;                  # marker 读不出 → 只算本次轮转
          *) _prev="$_d"; _n=$((_n - 1)) ;;   # marker 不是调用行
        esac ;;
    esac
    if [ "$_n" -gt 2000 ]; then
      { printf '%s · rotation · dropped=%s\n' "$(date -Is)" "$((_prev + _n - 1000))"
        tail -n 1000 "$_log"; } > "$_log.tmp.$$" 2>/dev/null \
        && mv "$_log.tmp.$$" "$_log" 2>/dev/null || rm -f "$_log.tmp.$$" 2>/dev/null
    fi
  fi
fi

# ── 拒绝解释 / 放行 ──────────────────────────────────────────────────────────────────────────
if [ "$_act" = "refused" ]; then
  case "$_cls" in
    server)      _why="kill-server 作用于整台 server —— 共享默认 socket 上不存在属于任何项目的命名对象" ;;
    widening)    _why="kill-session -a 会波及这台共享 server 上除目标外的**所有**会话，没有哪个命名目标能约束它" ;;
    no-target)   _why="没有给出非空的 -t 目标（空目标等于当前窗口/会话，无法证明它是本项目的命名对象）" ;;
    not-literal) _why="-t '$_t_val' 不是字面 session 名（%N / @N / :win / . / + / - 这类目标不受 session 约束）" ;;
    no-identity) _why="环境里没有 TEAM_SESSION —— 无法证明目标是本项目的会话（继承来的身份不算授权）" ;;
    not-own)     _why="-t '$_t_val' 的 session 段是 '$_sess'，与本项目身份 TEAM_SESSION='${TEAM_SESSION:-}' 不符" ;;
    unbound)     _why="TEAM_SESSION='${TEAM_SESSION:-}' 没有绑定到调用者（TEAM_ROOT / TEAM_MAIN_ROOT 都不是 cwd '$_shim_cwd' 或它的祖先）—— 继承来的身份不算授权" ;;
    unprovable)  _why="-t 之外的参数无法解析（tmux 自己会报 usage 错；闸门按「不可证明」拒绝）" ;;
    ambiguous)   _why="子命令前缀 '$_sub' 在 tmux 里有歧义" ;;
    fake-isolation) _why="TMUX_TMPDIR 声明的私有目录不可用，真 tmux 会静默回退默认 socket（假隔离）—— 即使 -t 看着是自己的，命中的同名会话也可能是共享 server 上别人的" ;;
    *)           _why="目标不是本项目自己的命名对象" ;;
  esac
  printf '✗ teamsmith tmux 闸门：已拒绝 %s —— %s\n' "$_sub" "$_why" >&2
  printf '  解析出的 socket：%s（共享默认 server：本机所有项目共用）\n' "$_sock" >&2
  printf '  调用参数：%s\n' "${_argv:-$_sub}" >&2
  if [ "$_tmpdir_fell_back" = "1" ]; then
    if [ -e "${TMUX_TMPDIR:-}" ]; then
      printf '  ⚠ 这是**假隔离**：TMUX_TMPDIR=%s 不是目录，真 tmux 不会用它（直接报错），私有隔离没有生效\n' \
        "${TMUX_TMPDIR:-}" >&2
    else
      printf '  ⚠ 这是**假隔离**：TMUX_TMPDIR=%s 指向不存在的目录，真 tmux 会静默回退默认 socket\n' \
        "${TMUX_TMPDIR:-}" >&2
    fi
    printf '  修法：先 mkdir -p 那个目录，再 env -u TMUX -u TMUX_PANE TMUX_TMPDIR=<已建目录> tmux …\n' >&2
  fi
  printf '  唯一的带内放行（一次性、记 act=explicit-flag）：把 token 放在**子命令之前**：\n' >&2
  printf '    tmux --teamsmith-allow-destructive %s\n' "${_argv:-$_sub}" >&2
  printf '  或换私有 server：env -u TMUX -u TMUX_PANE TMUX_TMPDIR=<已 mkdir -p 的私有目录> tmux …（socket 落到私有目录即放行）\n' >&2
  exit 64
fi

# 执行调用者原始的 argv（判定副本、执行原件 —— 见文件头「透传保真」）；
# 唯一的过滤是闸门自己的 token：剥掉它，其余逐字节原样。
if [ "$_tokenn" -eq 0 ]; then
  exec "$_real" ${_shim_argv[@]+"${_shim_argv[@]}"}
fi
_exec_argv=()
_i=0
while [ "$_i" -lt "$_shim_argc" ]; do
  if [ "$_i" -lt "$_glob_end" ] && [ "${_shim_argv[$_i]}" = "--teamsmith-allow-destructive" ]; then
    _i=$((_i + 1)); continue
  fi
  _exec_argv+=("${_shim_argv[$_i]}"); _i=$((_i + 1))
done
if [ "${#_exec_argv[@]}" -gt 0 ]; then
  exec "$_real" "${_exec_argv[@]}"
fi
exec "$_real"
