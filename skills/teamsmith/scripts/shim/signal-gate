#!/usr/bin/env bash
# teamsmith · 信号闸门（P159 · safe-signal-discipline；P167/P321 · 选择器入口）—— 被注入到 agent
# 会话（PM 与 worker 窗口）PATH 最前的包装：`pkill` / `killall` / `pgrep` / `pidof` 四个名字共用本实现。
#
# 入口形状（P321）：同目录的四个名字是**普通文件**（各自几行的 wrapper），不是软链 —— npm 的 tarball
# 不携带 120000 软链，0.3.0 的包里四个入口全部缺失、装完落到 /usr/bin（docs/team/reviews/release-0.3.0.md）。
# wrapper 把自己的名字作为**第一个参数**交给本文件；本文件被软链直接调用（历史形状）时按 basename 认名字。
# 入口名只决定「哪个工具被拦」，不授予任何放行：四个名字走同一套判定、同一份记录。
#
# 为什么存在：三次同族事故都是「按名字/命令行模式选进程」——模式命中了别的项目、别的会话里的同名
# 进程，也命中了调用者自己的 shell（模式串就在那条命令行里）：
#   · D37（2026-09-22）dev3 按 `panel.js.*--root /tmp/panel-p21` 模式 SIGSTOP 冻结了别人的夹具；
#   · D57/#1529（2026-09-29）用 `pgrep -f "<模式>"` 取 pid 时模式命中**自己这条命令**，随后按模式
#     比对的「来源核对」给自身发了信号；
#   · D72 dev-bob 的 `pkill -f` 误杀了同期的门禁客户端。
# 名字/命令行模式不是身份。闸门管的正是窗口里的 ad-hoc 调用（静态那一半由 tests/signal-lint.pl 管）。
#
# 判定（D1/D2/D3，见 openspec/changes/safe-signal-discipline/design.md；选择器语法 = 已归档的
# openspec/changes/2026-10-03-signal-gate-pgrep，`boundary#Signals go to a recorded pid …`）：
#   · **没有可证明的选择形式**：`pkill`/`killall` 的 `-f <模式>`、`-x <名字>`、`-P <pid>`、`-u <user>`、
#     裸名字；`pgrep` 的按名字/模式/所有者选择（裸名字、`-f` 出 PID、`-u`/`-U`/`-G`…）、`pidof` 的
#     **一切选择形态** —— 一律拒绝（exit 64），不执行真身、不发任何信号、stdout 留空；
#   · 放行的只有三类形态，**都不授予任何信号权限**：
#     ① 帮助/版本：单个 `--help` / `-h` / `-V` / `--version`（四个工具都有）—— 不选择任何进程；
#     ② 显式 group/parent 的 PID 查询：`pgrep -g N` / `-P N`（N 是显式正整数）—— 诊断查询，
#        输出 PID 列表；
#     ③ 整命令模式计数：`pgrep -fc P` / `-f -c P` / `-c -f P`（P 非空且不以 `-` 开头）——
#        **按完整命令行模式匹配、只输出个数**，不出 PID 列表；分类看的是**整个 argv**，
#        不是「成员里有没有某个旗标」；
#   · 诊断不等于授权：`-g`/`-P` 交出的 PID 列表是**查询结果**，不是任何 spawner 记录过的身份；
#     `-fc` 的计数连 PID 都不是。拿它去发信号与 `kill $(ps …)` 同类 —— 闸门不把它当许可：
#     放行只意味着「原样递给真身并记 act=pass」；
#   · **没有带内放行 token**（tmux 闸门有 `--teamsmith-allow-destructive`，因为人在 argv 里能点名
#     对象；信号没有对象可点，那正是问题本身），也**不读任何环境变量当授权**
#     （TEAM_ALLOW_PATTERN_KILL=1 之类的继承值不改变任何判定）；
#   · `kill` / `ps` / `fuser` **不拦**：闸门是 PATH shim，exec 时只看到展开后的 argv，
#     `kill $(pgrep -f x)` 与 `kill $(cat job.pid)` 在它看来同样四个词 —— 拦 `kill` 要么堵死安全
#     路线、要么放过不安全的那条。绝对路径（/usr/bin/pkill、/usr/bin/pgrep）与没有把闸门目录放
#     PATH 最前的 shell、shell 函数、其它产 PID 列表的工具**同样是明说的边界**，由
#     tests/signal-lint.pl 静态覆盖仓库脚本。
#
# 记录（D4，与 tmux 家族同形）：每次调用追加一行到 $TEAM_SIGNAL_CALLS_LOG
#    `<ISO> · act=<pass|refused> · tool=<pkill|killall|pgrep|pidof> · argv=<…> · pid=<…> ppid=<…> cwd=<…>`
# 上限 2000 条**调用行**（超了留最新 1000 条；首行 `<ISO> · rotation · dropped=<N>` 轮转标记自述
# 被裁掉多少，N 读不出时从 0 重算）。`act=refused` 的行在写主日志**之前**先逐字节复制进
# `<log>.forensics` —— 拒绝记录熬得过主日志轮转；复制失败仍走原判定与退出码，只在本行末尾补
# `retention=failed` + stderr 一行 ✗ 点名路径（失败可见，绝不改判定，也绝不挂住调用）。
#
# 真身解析（只读形式才需要）：`pkill`/`killall` 优先 TEAM_SIGNAL_REAL（fixture 钉桩用，与
# TEAM_TMUX_REAL 同形）；`pgrep`/`pidof` **忽略**这个旧 pin（它通常钉在 pkill 上 —— 把放行的诊断
# 调用路由过去等于换个名字发信号），只按自己的名字在 PATH 里找第一个**闸门目录之外**的同名文件。
# 拒绝**不依赖**真身能不能解析出来。
set -u

# ── 我是谁：入口名 = 被拦截的工具（只应是 pkill / killall / pgrep / pidof）──────────────────
# 两种入口都认：① 同名软链/同名文件（basename 就是工具名）；② 普通文件 wrapper —— npm 带不了软链，
# 所以 wrapper 把自己的名字作为**第一个参数**传进来，这里摘掉它，剩下的才是调用者的原始 argv
# （记录与透传都用摘掉之后的那份）。
_shim_self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
_gate_dir="$(cd -P "$(dirname "$_shim_self")" 2>/dev/null && pwd -P)" || _gate_dir="$(dirname "$_shim_self")"
_argv0="$(basename "$0")"
case "$_argv0" in
  pkill|killall|pgrep|pidof) _tool="$_argv0" ;;
  signal-gate)
    if [ "$#" -gt 0 ]; then _tool="$1"; shift; else _tool=""; fi ;;
  *)
    printf '✗ teamsmith 信号闸门：本文件只应以 pkill / killall / pgrep / pidof 的名字被调用（当前 %s）—— 同目录的同名入口是 wrapper\n' \
      "${_argv0:-?}" >&2
    exit 2 ;;
esac
case "$_tool" in
  pkill|killall|pgrep|pidof) ;;
  *)
    printf '✗ teamsmith 信号闸门：本文件只应以 pkill / killall / pgrep / pidof 的名字被调用（当前 %s）—— 同目录的同名入口是 wrapper\n' \
      "${_tool:-?}" >&2
    exit 2 ;;
esac

# 原始 argv 快照（记录与「逐字节透传」都看它）
_shim_argv=("$@")
_shim_argc=$#
_shim_cwd="$(pwd -P 2>/dev/null || printf '%s' "${PWD:-}")"
_argv="$(printf '%s' "$*" | tr '\r\n' '  ')"

# ── 判定：按**整个 argv** 分类（D2/D3）───────────────────────────────────────────────────────
# `_is_positive_int` 只认 [1-9][0-9]*：0 是「隐式调用者进程组/父进程」的简写、负数与前导 0 都是
# 非显式 ID，一律不算可证明的显式标量。`_is_info_token` 是四个工具共享的只读信息词。
_is_positive_int() { # <v> → 0 = 显式正整数
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    0*) return 1 ;;
    *) return 0 ;;
  esac
}
_is_info_token() { case "${1:-}" in --help|-h|-V|--version) return 0 ;; *) return 1 ;; esac; }

_act="refused"
_pat=""
case "$_tool" in
  pkill|killall)
    [ "$_shim_argc" -eq 1 ] && _is_info_token "$1" && _act="pass"
    ;;
  pgrep)
    if [ "$_shim_argc" -eq 1 ]; then
      _is_info_token "$1" && _act="pass"
    elif [ "$_shim_argc" -eq 2 ]; then
      case "$1" in
        -g|-P) _is_positive_int "$2" && _act="pass" ;;
        -fc)   [ -n "$2" ] && [ "${2#-}" = "$2" ] && _act="pass" ;;
      esac
    elif [ "$_shim_argc" -eq 3 ]; then
      case "$1" in
        -f) [ "$2" = "-c" ] && _pat="$3" ;;
        -c) [ "$2" = "-f" ] && _pat="$3" ;;
      esac
      [ -n "$_pat" ] && [ "${_pat#-}" = "$_pat" ] && _act="pass"
    fi
    ;;
  pidof)
    [ "$_shim_argc" -eq 1 ] && _is_info_token "$1" && _act="pass"
    ;;
esac

# ── 有界追加（与 tmux 闸门逐字同源，P132/P77/P87）：<file> ← $_line ─────────────────────────────
# 写不进去不挡路；FIFO 目标直接判失败（日志绝不能挂住调用）；超 2000 条调用行留最新 1000 条，
# 首行一条累计 `dropped=<N>` 的轮转标记；marker 不是调用行（不计入上限、也不保留）；N 读不出
# （空/非数字/超出整数范围回绕）时累计从 0 重启，绝不把读错的数写回去。返回非 0 只表示追加失败。
_bounded_append() { # <file>
  local _f="$1" _n _prev _first _t _rest _d _p _z _canon
  [ -p "$_f" ] && return 1
  { printf '%s\n' "$_line" >> "$_f"; } 2>/dev/null || return 1
  _n="$(wc -l < "$_f" 2>/dev/null | tr -dc '0-9')"
  if [ -n "$_n" ] && [ "$_n" -gt 2000 ]; then
    _prev=0
    _first="$(head -n 1 "$_f" 2>/dev/null || true)"
    _t="${_first%% · *}"
    _rest="${_first#"$_t"}"
    case "$_rest" in
      ' · rotation · dropped='*)
        _n=$((_n - 1))
        _d="${_rest#' · rotation · dropped='}"
        case "$_d" in
          ''|*[!0-9]*) _prev=0 ;;
          *)
            _p="$((10#$_d))"
            _z="${_d%%[!0]*}"; _canon="${_d#"$_z"}"
            if [ "$_canon" = "$_p" ]; then _prev="$_p"; else _prev=0; fi ;;
        esac ;;
    esac
    if [ "$_n" -gt 2000 ]; then
      { printf '%s · rotation · dropped=%s\n' "$(date -Is)" "$((_prev + _n - 1000))"
        tail -n 1000 "$_f"; } > "$_f.tmp.$$" 2>/dev/null \
        && mv "$_f.tmp.$$" "$_f" 2>/dev/null || rm -f "$_f.tmp.$$" 2>/dev/null
    fi
  fi
  return 0
}

if [ -n "${TEAM_SIGNAL_CALLS_LOG:-}" ] && [ ! -p "${TEAM_SIGNAL_CALLS_LOG}" ]; then
  _log="${TEAM_SIGNAL_CALLS_LOG}"
  _ld="$(dirname "$_log")"
  [ -d "$_ld" ] || mkdir -p "$_ld" 2>/dev/null || true
  # 这一行是唯一的格式源：主日志与长保留副本逐字节同一行（跨文件 grep -F / cmp 对齐的锚）。
  printf -v _line '%s · act=%s · tool=%s · argv=%s · pid=%s ppid=%s cwd=%s' \
    "$(date -Is)" "$_act" "$_tool" "$_argv" "$$" "${PPID:-?}" "$_shim_cwd"
  # 长保留：拒绝的记录在写主日志**之前**先复制进 <log>.forensics；pass 不承诺保留（不建文件、不追行）。
  _retfail=0
  if [ "$_act" != "pass" ]; then
    _flog="${_log}.forensics"
    _bounded_append "$_flog" || _retfail=1
  fi
  if [ "$_retfail" = 1 ]; then
    _line="$_line · retention=failed"
    printf '✗ teamsmith 信号闸门：本次调用的拒绝记录没能写进长保留文件（%s）—— 判定与退出码不受影响；本行已用 retention=failed 自述\n' \
      "$_flog" >&2
  fi
  _bounded_append "$_log" || true
fi

# ── 拒绝解释（exit 64；不执行真身、不发信号、不解析真身）──────────────────────────────────────
if [ "$_act" = "refused" ]; then
  printf '✗ teamsmith 信号闸门：已拒绝 %s —— 名字或命令行模式**不是身份**，无法证明这些进程归调用者\n' "$_tool" >&2
  printf '  调用参数：%s\n' "$_tool${_argv:+ $_argv}" >&2
  printf '  为什么：模式/名字会同时命中别的项目、别的会话里的同名进程，也会命中调用者自己的 shell（模式串就在这条命令行里）。\n' >&2
  case "$_tool" in
    pgrep)
      printf '  pgrep 只放行三类形态，**都不授予信号权限**：\n    · 帮助/版本：`--help` / `-h` / `-V` / `--version`（不选择任何进程）；\n    · 显式 group/parent 的 PID 查询：`-g <正整数>` / `-P <正整数>`（输出 PID 列表）——\n      结果是查询输出，不是任何记录过的身份；\n    · 整命令模式计数：`-fc <命令>`（含 `-f -c` / `-c -f`）—— 按完整命令行模式匹配，\n      只出个数不出 PID 列表。\n' >&2 ;;
    pidof)
      printf '  pidof 按名字选择是它的定义：只放行单个 `--help`/`-h`/`-V`/`--version`。\n' >&2 ;;
  esac
  printf '  安全路线（信号只发给**记录过的 pid**）：\n' >&2
  printf '    · team bg list           看本项目后台作业记录到的 pid\n' >&2
  printf '    · team bg stop <id>      按记录停作业（先验 pid + 启动时间指纹）\n' >&2
  printf '    · kill <记录过的 pid>     你自己 spawn 时记下的 pid（kill 不经过本闸门）\n' >&2
  exit 64
fi

# ── 放行：解析真身（pkill/killall 认 TEAM_SIGNAL_REAL；选择器只认自己的名字、跳过闸门目录），透传 ──
_real=""
if [ "$_tool" = "pkill" ] || [ "$_tool" = "killall" ]; then
  if [ -n "${TEAM_SIGNAL_REAL:-}" ] && [ -x "${TEAM_SIGNAL_REAL:-}" ]; then
    _c="$(readlink -f "$TEAM_SIGNAL_REAL" 2>/dev/null || printf '%s' "$TEAM_SIGNAL_REAL")"
    _cd="$(cd -P "$(dirname "$_c")" 2>/dev/null && pwd -P)"
    if [ "$_c" != "$_shim_self" ] && [ "$_cd" != "$_gate_dir" ]; then _real="$TEAM_SIGNAL_REAL"; fi
  fi
fi
if [ -z "$_real" ]; then
  _oldifs="$IFS"; IFS=':'
  for _d in $PATH; do
    IFS="$_oldifs"
    [ -n "$_d" ] || continue
    _cand="$_d/$_tool"
    [ -x "$_cand" ] || continue
    _cc="$(readlink -f "$_cand" 2>/dev/null || printf '%s' "$_cand")"
    if [ "$_cc" = "$_shim_self" ]; then continue; fi
    _cd="$(cd -P "$(dirname "$_cc")" 2>/dev/null && pwd -P)"
    [ "$_cd" = "$_gate_dir" ] && continue
    _real="$_cand"; break
  done
  IFS="$_oldifs"
fi
if [ -z "$_real" ]; then
  case "$_tool" in
    pkill|killall)
      printf '✗ teamsmith 信号闸门：PATH 里找不到真的 %s（只找到我自己）——把真身的目录加进 PATH，或设 TEAM_SIGNAL_REAL=<绝对路径>\n' \
        "$_tool" >&2 ;;
    *)
      printf '✗ teamsmith 信号闸门：PATH 里找不到真的 %s（闸门目录之外）——把真身的目录加进 PATH（%s 不读 TEAM_SIGNAL_REAL）\n' \
        "$_tool" "$_tool" >&2 ;;
  esac
  exit 127
fi
exec "$_real" ${_shim_argv[@]+"${_shim_argv[@]}"}
