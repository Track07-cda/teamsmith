# pi-team 看门狗镜像
#   模式 A（容器里开发，推荐）：容器只负责“守着” —— 用 podman-remote 驱动
#     `podman exec <你的开发容器> bash <skill>/scripts/team watch`，
#     于是 tmux/ps/pi 都在原环境里跑（版本一致、看得见进程），看门狗却活在容器里。
#   模式 B（裸机）：直接在容器里跑 watch（--pid=host），需要镜像里的 tmux 与宿主协议兼容。
ARG BASE=docker.io/library/alpine:3.20
FROM ${BASE}

RUN apk add --no-cache bash git tmux procps coreutils grep sed gawk tzdata podman-remote

ENTRYPOINT ["/bin/bash"]
